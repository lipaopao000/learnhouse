# Windows origin cache. Dedicated process; it never serves host directories.
worker_processes 1;
pid logs/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 512; }
http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
    log_format video '$time_iso8601 $remote_addr $request_method $uri $status '
                     '$body_bytes_sent cache=$upstream_cache_status upstream=$upstream_addr';
    access_log logs/access.log video;
    proxy_cache_path D:/deploy/LearnHouseVideo/cache levels=1:2
        keys_zone=video_origin:8m inactive=90d use_temp_path=off;
    server {
        listen __ORIGIN_IP__:18887;
        server_name _;
        allow 100.64.0.3;
        deny all;
        if ($http_x_learnhouse_origin_key != "__ORIGIN_KEY__") { return 403; }
        location ~ ^/api/v1/stream/(video|block)/ {
            limit_except GET HEAD { deny all; }
            proxy_pass http://100.64.0.6:8806;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host syyedu.toofun.fun;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-LearnHouse-Origin-Key "";
            # Bounded origin requests avoid long-lived home uplink transfers.
            slice 4m;
            proxy_set_header Range $slice_range;
            proxy_set_header If-Range "";
            proxy_cache video_origin;
            proxy_cache_key "$uri$slice_range";
            proxy_cache_valid 200 206 90d;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 600s;
            proxy_cache_lock_age 600s;
            proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
            proxy_hide_header Set-Cookie;
            proxy_hide_header Vary;
            proxy_hide_header Cache-Control;
            proxy_force_ranges on;
            proxy_ignore_client_abort on;
            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            add_header Cache-Control "private, no-store" always;
            add_header X-LearnHouse-Origin-Cache $upstream_cache_status always;
        }
        location / { return 404; }
    }
}
