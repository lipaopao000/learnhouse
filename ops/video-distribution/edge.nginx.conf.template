# Separate cloud nginx process; existing nginx/Lucky listeners are unchanged.
user www-data;
worker_processes 2;
pid /run/learnhouse-video-edge.pid;
error_log /opt/learnhouse-video-edge/logs/error.log warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    map $http_upgrade $learnhouse_connection_upgrade { default upgrade; '' ''; }
    # Smooth connection bursts to the home permissions service, without caching
    # permissions. Normal video byte transfer rate is not limited.
    limit_req_zone $server_name zone=learnhouse_video_starts:1m rate=50r/s;
    log_format video '$time_iso8601 $remote_addr $request_method $uri $status '
        '$body_bytes_sent cache=$upstream_cache_status upstream=$upstream_addr rt=$request_time';
    access_log /opt/learnhouse-video-edge/logs/access.log video;
    proxy_cache_path /opt/learnhouse-video-edge/cache levels=1:2
        keys_zone=video_edge:8m max_size=3g inactive=30d use_temp_path=off;
    upstream learnhouse_video_origin {
        server __ORIGIN_IP__:18887 max_fails=2 fail_timeout=15s;
        # A cold miss can fall back to the original application if origin is offline.
        server 100.64.0.6:8806 backup;
        keepalive 8;
    }
    server {
        listen 127.0.0.1:18887;
        server_name syyedu.toofun.fun;
        client_max_body_size 6g;
        large_client_header_buffers 4 32k;
        location ^~ /__learnhouse_export/ { return 404; }
        location ~ ^/api/v1/stream/(video/|block/(?!audio/)) {
            limit_req zone=learnhouse_video_starts burst=400;
            limit_req_status 503;
            limit_except GET HEAD { deny all; }
            # ALWAYS authorise before cache access, including cache hits.
            auth_request /__learnhouse_video_auth;
            proxy_pass http://learnhouse_video_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host syyedu.toofun.fun;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-LearnHouse-Origin-Key "__ORIGIN_KEY__";
            slice 4m;
            proxy_set_header Range $slice_range;
            proxy_set_header If-Range "";
            proxy_cache video_edge;
            proxy_cache_key "$uri$slice_range";
            proxy_cache_valid 200 206 30d;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 600s;
            proxy_cache_lock_age 600s;
            proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
            proxy_hide_header Set-Cookie;
            proxy_hide_header Vary;
            proxy_hide_header Cache-Control;
            proxy_hide_header X-LearnHouse-Origin-Cache;
            proxy_force_ranges on;
            proxy_connect_timeout 5s;
            proxy_read_timeout 600s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            add_header Cache-Control "private, no-store" always;
            add_header X-LearnHouse-Video-Cache $upstream_cache_status always;
        }
        location = /__learnhouse_video_auth {
            internal;
            proxy_pass http://100.64.0.6:8806$request_uri;
            proxy_method HEAD;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Range "";
            proxy_set_header If-Range "";
            proxy_set_header If-None-Match "";
            proxy_set_header If-Modified-Since "";
            proxy_set_header Host syyedu.toofun.fun;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Authorization $http_authorization;
            proxy_connect_timeout 5s;
            proxy_read_timeout 20s;
            proxy_cache off;
            proxy_intercept_errors on;
            error_page 404 =403 /__learnhouse_video_denied;
        }
        location = /__learnhouse_video_denied { internal; return 403; }
        # Original application handles everything else, including uploads and WS.
        location / {
            proxy_pass http://100.64.0.6:8806;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Real-IP $http_x_real_ip;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $learnhouse_connection_upgrade;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
